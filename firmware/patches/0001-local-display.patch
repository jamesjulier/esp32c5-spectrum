diff --git a/main/families/c5_c6_c61/receiver.c b/main/families/c5_c6_c61/receiver.c
index 7d380c3..02747c8 100644
--- a/main/families/c5_c6_c61/receiver.c
+++ b/main/families/c5_c6_c61/receiver.c
@@ -7,6 +7,7 @@
 #include "esp_cpu.h"
 #include "esp_event.h"
 #include "esp_log.h"
+#include "esp_mac.h"
 #include "esp_phy_cert_test.h"
 #include "esp_rom_crc.h"
 #include "esp_rom_sys.h"
@@ -273,6 +274,73 @@ static bool ring_test(const char *line) {
 
 static void handle_command(char *line);
 
+#ifdef ESP_SDR_LOCAL_DISPLAY
+/* Modified by James Julier, 2026 (github.com/jamesjulier/esp32c5-spectrum).
+ * Local display: the board drives its own receiver and draws
+ * the spectrum on its screen, with no host. See eng_spectrum_ui.h. */
+#include "eng_spectrum_ui.h"
+#include "rx_bandwidth.h"
+static void local_tune(unsigned mhz) {
+    frequency_mhz = mhz;
+    rx_ready = false;
+    prepare_rx();
+}
+static bool local_spectrum(unsigned rate, unsigned n, unsigned ffts, uint8_t *codes) {
+    return spectrum_snapshot(n, rate, ffts, spectrum_acquire, codes);
+}
+/* The receiver as the screen wants it: widest bandwidth, PHY-calibrated
+ * filter, hardware AGC. Applied at start and again after a host session,
+ * which may have changed any of them. */
+static void local_rx_defaults(void) {
+    rx_analog_filter = rx_bandwidth_dcap(0);
+#if CONFIG_IDF_TARGET_ESP32C5
+    rx_channel_mode = rx_bandwidth_phy_mode(0);
+#endif
+#if !CONFIG_IDF_TARGET_ESP32C6
+    rx_filter = -1;
+#endif
+    gain_mode = GAIN_HARDWARE;
+    rx_ready = false;
+    prepare_rx();
+}
+/* A phone or laptop (ESP-WebSDR, over USB) can take the radio at any time.
+ * local_host_waiting() is polled between captures; a complete command line is
+ * kept for local_host_serve(), which serves the host exactly as the stock
+ * firmware does until it has been silent for 10 s, then restores the screen's
+ * receiver settings. */
+static char local_line[128];
+static int local_status;
+static bool local_host_waiting(void) {
+    local_status = burst_serial_poll_line(local_line, sizeof(local_line));
+    /* the screen's own commands (SNAP, TAP x y, ...) are answered here and
+     * never reach the host protocol, so a screenshot does not hand the radio to
+     * a viewer. */
+    if (local_status > 0 && eng_spectrum_local_command(local_line, burst_serial_send)) local_status = 0;
+    return local_status != 0;
+}
+static void local_host_serve(void) {
+    int64_t last = esp_timer_get_time();
+    for (;;) {
+        if (local_status > 0) {
+            if (!strcmp(local_line, "RELEASE")) reply("OK\n");
+            /* The screen, touch, backlight and BOOT button sit on the GPIOs that
+             * ESP-SDR's GPIO command frees up, and a host taking a pin would leave
+             * the screen dead after it lets go. Reading them (GPIO?) is fine. */
+            else if (!strncmp(local_line, "GPIO ", 5)) reply("ERR gpio_reserved_by_display\n");
+            else handle_command(local_line);
+            last = esp_timer_get_time();
+        } else if (local_status < 0) {
+            reply("ERR command_length\n");
+            last = esp_timer_get_time();
+        }
+        if (esp_timer_get_time() - last > 10000000) break;
+        local_status = burst_serial_poll_line(local_line, sizeof(local_line));
+        if (!local_status) vTaskDelay(1);
+    }
+    local_rx_defaults();
+}
+#endif
+
