+#ifdef ESP_SDR_LOCAL_DISPLAY
+    burst_serial_init();   /* so a phone or laptop can still take over */
+    local_rx_defaults();
+    eng_spectrum_run(local_tune, local_spectrum, local_host_waiting, local_host_serve); /* does not return */
+#endif
     burst_serial_init();
     burst_serial_serve(handle_command);
 }
