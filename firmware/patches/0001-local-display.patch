diff --git a/main/common/spectrum.c b/main/common/spectrum.c
index 6abfbf9..1e422d4 100644
--- a/main/common/spectrum.c
+++ b/main/common/spectrum.c
@@ -18,7 +18,14 @@
 #include <stdio.h>
 #include <string.h>
 
+#ifdef ESP_SDR_LOCAL_DISPLAY
+/* The engineer screen uses 1024-point FFTs only. Halving the buffers frees
+ * ~13 KB of the C5's .bss, which otherwise has ~1 KB left before the RF dump
+ * bank (targets/esp32c5/sram_guard.ld). */
+#define MAX_FFT      1024u
+#else
 #define MAX_FFT      2048u
+#endif
 #define HEADER_BYTES 28u
 #if CONFIG_IDF_TARGET_ESP32C2
 /* Quiescent during RF capture; keep heap/stacks in the other SRAM banks. */
@@ -281,3 +288,52 @@ bool spectrum_command(const char *line, unsigned frequency_mhz, spectrum_acquire
     send_text(text);
     return true;
 }
+
+/* Modified by James Julier, 2026 (github.com/jamesjulier/esp32c5-spectrum).
+ * Local display build (firmware/ in the esp32c5-spectrum
+ * repository). The same capture, window, FFT, DC removal and power path as SPEC,
+ * returning MEAN-power codes (SPEC's detector 0) to the caller instead of
+ * sending frames. Mean, as a bench analyser's average detector: a busy channel
+ * reads as a steady level rather than flickering with each burst. */
+static void snapshot_no_poll(void *context) {
+    (void)context;
+}
+bool spectrum_snapshot(unsigned n, unsigned rate, unsigned ffts, spectrum_acquire_fn acquire, uint8_t *codes) {
+    if (!rate_hz(rate) || n < 256 || n > MAX_FFT || (n & (n - 1)) || !ffts) return false;
+    spectrum_fft_init();
+    if (!ready) return false;
+    if (setup_n != n) {
+        for (unsigned j = 0; j < n; j++) window[j] = (int16_t)lrintf(16383.5f * (1 - cosf(2 * M_PI * j / n)));
+        setup_n = n;
+    }
+    spectrum_dc_mode = 1;
+    spectrum_dc_t dc = {0};
+    memset(&powers, 0, n * sizeof(float));
+    for (unsigned k = 0; k < ffts; k++) {
+        const uint32_t *words;
+        unsigned elapsed;
+        if (!acquire(n, rate, &words, &elapsed)) return false;
+        for (unsigned j = 0; j < n; j++) {
+            int32_t i = ((int32_t)(words[j] << 22) >> 22), q = ((int32_t)(words[j] << 12) >> 22);
+            fft_data[2 * j] = clamp16((i * window[j]) >> 9);
+            fft_data[2 * j + 1] = clamp16((q * window[j]) >> 9);
+        }
+        spectrum_fft_poll(fft_data, n, dsps_fft_w_table_sc16, snapshot_no_poll, NULL);
+        spectrum_dc_apply(&dc, fft_data, n);
+        for (unsigned j = 0; j < n; j++) {
+            powers.mean[j] += (float)spectrum_complex_power(fft_data[2 * j], fft_data[2 * j + 1]);
+        }
+    }
+    /* Undo the FFT's bit-reversed order, exactly as pack_spectrum() does. */
+    const float scale = 1.0f / ffts;
+    for (unsigned j = 0, bin = 0; j < n; j++) {
+        codes[bin] = spectrum_mean_power_code(powers.mean[j] * scale);
+        unsigned bit = n >> 1;
+        while (bin & bit) {
+            bin ^= bit;
+            bit >>= 1;
+        }
+        bin ^= bit;
+    }
+    return true;
+}
